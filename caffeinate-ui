#!/usr/bin/env python3
"""
caffeinate-ui: Elegante CLI TUI per macOS caffeinate.
Mantiene display e sistema attivi con feedback visivo in tempo reale,
cronometro, timer con barra di avanzamento e controlli rapidi da tastiera.
"""

import sys
import os
import time
import subprocess
import signal
import atexit
import select
import termios
import tty
import argparse
import re
from datetime import datetime

# ANSI Colors & Styles
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
ITALIC = "\033[3m"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"

GREEN = "\033[38;5;48m"
CYAN = "\033[38;5;51m"
YELLOW = "\033[38;5;220m"
ORANGE = "\033[38;5;208m"
RED = "\033[38;5;196m"
GRAY = "\033[38;5;244m"
WHITE = "\033[38;5;255m"

STEAM_FRAMES = [
    "  (  (  ",
    "   )  ) ",
    "  (  (  ",
    "   )  ) ",
]

def parse_duration(val: str) -> int:
    """Parsa stringhe di durata come 45m, 2h, 1h30m, 90s, 300 in secondi."""
    if not val:
        return 0
    val = val.strip().lower()
    if val.isdigit():
        # Default numeric value is treated as minutes if <= 180, otherwise seconds
        num = int(val)
        return num * 60 if num <= 180 else num
    
    pattern = r'(?:(\d+(?:\.\d+)?)\s*h)?\s*(?:(\d+(?:\.\d+)?)\s*m)?\s*(?:(\d+(?:\.\d+)?)\s*s)?'
    match = re.fullmatch(pattern, val)
    if not match:
        raise ValueError(f"Formato durata non valido: '{val}'. Esempi validi: 30m, 2h, 1h30m, 45s.")
    
    hours = float(match.group(1)) if match.group(1) else 0
    minutes = float(match.group(2)) if match.group(2) else 0
    seconds = float(match.group(3)) if match.group(3) else 0
    total = int(hours * 3600 + minutes * 60 + seconds)
    if total <= 0:
        raise ValueError(f"La durata deve essere maggiore di zero.")
    return total

def format_time(seconds: float) -> str:
    secs = max(0, int(seconds))
    h = secs // 3600
    m = (secs % 3600) // 60
    s = secs % 60
    if h > 0:
        return f"{h:02d}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

def render_progress_bar(current: float, total: float, width: int = 22) -> str:
    if total <= 0:
        return ""
    pct = min(1.0, max(0.0, current / total))
    filled = int(width * pct)
    bar = f"{GREEN}{'█' * filled}{GRAY}{'░' * (width - filled)}{RESET}"
    return f"[{bar}] {int(pct * 100)}%"

def send_macos_notification(title: str, message: str):
    """Invia notifica nativa macOS con suono."""
    try:
        script = f'display notification "{message}" with title "{title}" sound name "Glass"'
        subprocess.run(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

class CaffeinateCLI:
    def __init__(self, mode_args=None, duration_seconds=0, notify=True, wait_pid=None):
        self.mode_args = mode_args or ["-d"]
        self.duration = duration_seconds
        self.notify = notify
        self.wait_pid = wait_pid
        self.proc = None
        self.is_paused = False
        self.start_time = None
        self.pause_start = None
        self.total_paused_time = 0
        self.orig_term_settings = None
        self.is_tty = sys.stdin.isatty() and sys.stdout.isatty()
        self.last_line_count = 0
        self.exit_reason = "interrupted"

    def _cleanup_terminal(self):
        if self.is_tty and self.orig_term_settings:
            try:
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.orig_term_settings)
            except Exception:
                pass
        sys.stdout.write(SHOW_CURSOR)
        sys.stdout.flush()

    def _terminate_process(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=1.0)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
            self.proc = None

    def cleanup(self):
        self._terminate_process()
        self._cleanup_terminal()

    def toggle_pause(self):
        if not self.proc:
            return
        if not self.is_paused:
            try:
                os.kill(self.proc.pid, signal.SIGSTOP)
                self.is_paused = True
                self.pause_start = time.time()
            except Exception:
                pass
        else:
            try:
                os.kill(self.proc.pid, signal.SIGCONT)
                self.is_paused = False
                if self.pause_start:
                    self.total_paused_time += time.time() - self.pause_start
                    self.pause_start = None
            except Exception:
                pass

    def adjust_duration(self, delta_seconds: int):
        if self.duration <= 0:
            self.duration = int(self.get_effective_elapsed()) + max(60, delta_seconds)
        else:
            new_dur = self.duration + delta_seconds
            elapsed = self.get_effective_elapsed()
            if new_dur > elapsed:
                self.duration = new_dur

    def get_effective_elapsed(self) -> float:
        if not self.start_time:
            return 0
        now = time.time()
        paused = self.total_paused_time
        if self.is_paused and self.pause_start:
            paused += (now - self.pause_start)
        return max(0.0, now - self.start_time - paused)

    def draw_ui(self, frame_idx: int):
        elapsed = self.get_effective_elapsed()
        steam = STEAM_FRAMES[frame_idx % len(STEAM_FRAMES)]

        flags_desc = []
        if "-d" in self.mode_args:
            flags_desc.append("Schermo")
        if "-i" in self.mode_args:
            flags_desc.append("Idle sistema")
        if "-m" in self.mode_args:
            flags_desc.append("Disco")
        if "-s" in self.mode_args:
            flags_desc.append("Standby AC")
        desc = " + ".join(flags_desc) if flags_desc else " ".join(self.mode_args)

        status_text = f"{GREEN}● ATTIVO{RESET}" if not self.is_paused else f"{YELLOW}❚❚ IN PAUSA{RESET}"
        status_sub = f"Prevenzione: {desc}" if not self.is_paused else "Caffeinate temporaneamente sospeso"

        started_str = datetime.fromtimestamp(self.start_time).strftime("%H:%M:%S")
        elapsed_str = format_time(elapsed)

        lines = [
            f"   {ORANGE}{BOLD}☕  CAFFEINATE MAC CLI{RESET}  {DIM}v1.1{RESET}",
            f"   {GRAY}─────────────────────────────────────────────{RESET}",
            f"   Stato:        {status_text}  {DIM}({status_sub}){RESET}",
            f"   PID Processo: {WHITE}{self.proc.pid if self.proc else '-'}{RESET}",
            f"   Avviato alle: {WHITE}{started_str}{RESET}",
            f"   Tempo attivo: {BOLD}{CYAN}{elapsed_str}{RESET}",
        ]

        if self.wait_pid:
            lines.append(f"   In attesa di: PID {WHITE}{self.wait_pid}{RESET}")

        if self.duration > 0:
            remaining = max(0.0, self.duration - elapsed)
            rem_str = format_time(remaining)
            bar = render_progress_bar(elapsed, self.duration, width=20)
            end_time = datetime.fromtimestamp(self.start_time + self.duration + self.total_paused_time).strftime("%H:%M:%S")
            lines.append(f"   Rimanente:    {YELLOW}{BOLD}{rem_str}{RESET}  {DIM}(termine: ~{end_time}){RESET}")
            lines.append(f"   Progresso:    {bar}")

        lines.append(f"   Vapore tazza: {ORANGE}{steam}{RESET}")
        lines.append(f"   {GRAY}─────────────────────────────────────────────{RESET}")
        lines.append(f"   {BOLD}[q]{RESET} Esci pulito   {BOLD}[p]{RESET} Pausa   {BOLD}[+/-]{RESET} ±5min   {BOLD}[Ctrl+C]{RESET} Stop")

        content = "\n".join(lines) + "\n"

        if self.is_tty:
            if self.last_line_count > 0:
                sys.stdout.write(f"\033[{self.last_line_count}F\033[J")
            sys.stdout.write(content)
            self.last_line_count = len(lines)
        else:
            if self.last_line_count == 0:
                sys.stdout.write(content)
                self.last_line_count = len(lines)
        sys.stdout.flush()

    def run(self):
        atexit.register(self.cleanup)

        def handle_signal(sig, frame):
            self.exit_reason = "interrupted"
            self.cleanup()
            self._print_exit_summary()
            sys.exit(0)

        signal.signal(signal.SIGINT, handle_signal)
        signal.signal(signal.SIGTERM, handle_signal)

        # Build command: caffeinate [flags] [-w pid]
        cmd = ["caffeinate"] + self.mode_args
        if self.wait_pid:
            cmd += ["-w", str(self.wait_pid)]

        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            sys.stderr.write(f"{RED}Errore: il comando 'caffeinate' non è presente su questo sistema.{RESET}\n")
            sys.exit(1)

        self.start_time = time.time()

        if self.is_tty:
            try:
                self.orig_term_settings = termios.tcgetattr(sys.stdin)
                tty.setcbreak(sys.stdin.fileno())
                sys.stdout.write(HIDE_CURSOR)
                sys.stdout.flush()
            except Exception:
                self.is_tty = False

        frame_idx = 0
        try:
            while True:
                # Controlla se il processo caffeinate (o il processo watched) è terminato
                if self.proc.poll() is not None:
                    self.exit_reason = "process_finished"
                    break

                # Controlla completamento timer durata
                if self.duration > 0 and self.get_effective_elapsed() >= self.duration:
                    self.exit_reason = "timer_expired"
                    break

                self.draw_ui(frame_idx)
                frame_idx += 1

                # Gestione input non bloccante (tick 0.25s)
                try:
                    rlist, _, _ = select.select([sys.stdin], [], [], 0.25)
                    if rlist:
                        char = sys.stdin.read(1)
                        if not char or char in ('q', 'Q', '\x1b', '\x04'):
                            self.exit_reason = "user_quit"
                            break
                        elif char in ('p', 'P', ' '):
                            self.toggle_pause()
                        elif char in ('+', '='):
                            self.adjust_duration(300)
                        elif char in ('-', '_'):
                            self.adjust_duration(-300)
                except (select.error, IOError):
                    time.sleep(0.25)

        except KeyboardInterrupt:
            self.exit_reason = "interrupted"
        finally:
            self.cleanup()
            self._print_exit_summary()

    def _print_exit_summary(self):
        elapsed = self.get_effective_elapsed()
        elapsed_str = format_time(elapsed)

        sys.stdout.write("\n")
        if self.exit_reason == "timer_expired":
            sys.stdout.write(f"   {GREEN}✔  Timer completato!{RESET}\n")
            if self.notify:
                send_macos_notification("Caffeinate Timer Scaduto", f"Tempo attivo completato: {elapsed_str}. Il Mac può ora andare in standby.")
        elif self.exit_reason == "process_finished":
            sys.stdout.write(f"   {GREEN}✔  Processo monitorato terminato.{RESET}\n")
        else:
            sys.stdout.write(f"   {GREEN}✔  Sessione Caffeinate terminata.{RESET}\n")

        sys.stdout.write(f"   ⏱️  Tempo totale in cui il Mac è rimasto sveglio: {BOLD}{WHITE}{elapsed_str}{RESET}\n")
        sys.stdout.write(f"   💤 Il Mac può ora entrare in standby normalmente.\n\n")
        sys.stdout.flush()


def main():
    parser = argparse.ArgumentParser(
        prog="caffeinate-ui",
        description="CLI tool per macOS caffeinate con feedback visivo live, timer ed uscita pulita.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Esempi:
  caffeinate-ui               # Mantiene attivo il display a tempo indeterminato (-d)
  caffeinate-ui 45m           # Mantiene attivo per 45 minuti con countdown e notifica
  caffeinate-ui 2h            # Mantiene attivo per 2 ore
  caffeinate-ui 1h30m         # Mantiene attivo per 1 ora e 30 minuti
  caffeinate-ui -dims 30m     # Previene sonno display, idle, disco e standby
  caffeinate-ui -w 12345      # Mantiene sveglio finché il processo PID 12345 è in esecuzione

Tasti interattivi durante l'esecuzione:
  [q]       Esci e ripristina la normale gestione energetica
  [p]       Pausa / Riprendi temporaneamente l'effetto caffeinate
  [+]       Aggiungi 5 minuti alla durata
  [-]       Sottrai 5 minuti alla durata
  [Ctrl+C]  Interrompi in modo pulito
"""
    )

    parser.add_argument("duration", nargs="?", default=None,
                        help="Durata facoltativa (es. 15m, 1h, 1h30m, 45s, o minuti numerici).")
    parser.add_argument("-d", "--display", action="store_true", default=True,
                        help="Previeni spegnimento display (attivo di default).")
    parser.add_argument("-i", "--idle", action="store_true",
                        help="Previeni idle sleep di sistema.")
    parser.add_argument("-m", "--disk", action="store_true",
                        help="Previeni idle sleep del disco fisso.")
    parser.add_argument("-s", "--system", action="store_true",
                        help="Previeni sleep di sistema (valido solo con alimentazione AC).")
    parser.add_argument("-dims", "--all", action="store_true",
                        help="Attiva tutte le protezioni (-d, -i, -m, -s).")
    parser.add_argument("-w", "--wait-pid", type=int, default=None,
                        help="Attendi la terminazione del processo con il PID specificato.")
    parser.add_argument("--no-notify", action="store_true",
                        help="Disabilita la notifica nativa macOS al termine del timer.")

    args = parser.parse_args()

    duration_secs = 0
    if args.duration:
        try:
            duration_secs = parse_duration(args.duration)
        except ValueError as e:
            sys.stderr.write(f"{RED}Errore: {e}{RESET}\n")
            sys.exit(1)

    caff_args = []
    if args.all:
        caff_args = ["-d", "-i", "-m", "-s"]
    else:
        if args.idle:
            caff_args.append("-i")
        if args.disk:
            caff_args.append("-m")
        if args.system:
            caff_args.append("-s")
        if args.display or not caff_args:
            if "-d" not in caff_args:
                caff_args.append("-d")

    app = CaffeinateCLI(
        mode_args=caff_args,
        duration_seconds=duration_secs,
        notify=not args.no_notify,
        wait_pid=args.wait_pid
    )
    app.run()

if __name__ == "__main__":
    main()
